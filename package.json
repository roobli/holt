{
  "name": "@roobli/holt",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "File-backed personal task stack companion",
  "scripts": {
    "test": "node --experimental-strip-types --test src/core/*.test.ts src/commands.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "demo:dev": "vite --config demo/vite.config.ts",
    "demo:build": "vite build --config demo/vite.config.ts",
    "demo:preview": "vite preview --config demo/vite.config.ts",
    "gui:dev": "node --experimental-strip-types gui/dev.ts",
    "holt": "node --experimental-strip-types src/cli.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "typescript": "^5.8.2",
    "vite": "^6.2.0"
  },
  "bin": {
    "holt": "./bin/holt.mjs"
  }
}
